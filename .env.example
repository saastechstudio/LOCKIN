# Database (Neon Postgres serverless)
#
# Recommended setup: connect the "Neon" integration from the Vercel
# Marketplace to this project (Vercel → Project → Storage → Connect
# Database). It provisions DATABASE_URL automatically for Production AND
# for every Preview Deployment — each preview gets its own ephemeral Neon
# branch (a copy-on-write branch off the parent, created and torn down by
# the integration) so PRs never touch production data, and pending
# migrations run against that branch during the Vercel build (see
# `scripts/migrate.mjs`, wired as `prebuild`).
#
# The integration writes several variable names depending on how the
# project is connected; lib/db/index.ts and drizzle.config.ts accept all of
# them as fallbacks, but DATABASE_URL is the canonical one used below and
# in local dev.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/lockin?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.neon.tech/lockin?sslmode=require"
# POSTGRES_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/lockin?sslmode=require"
# POSTGRES_PRISMA_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/lockin?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon API — only needed for the optional CI-driven branch-per-PR workflow
# in .github/workflows/neon-preview-branches.yml (an explicit alternative/
# complement to the dashboard integration above). Create a scoped API key
# at https://console.neon.tech/app/settings/api-keys.
# NEON_API_KEY="napi_xxxxx"
# NEON_PROJECT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI (Vercel AI SDK). Essayés dans cet ordre — NVIDIA NIM (modèles open
# source, build.nvidia.com), Eden AI (passerelle multi-fournisseurs),
# Mistral, Anthropic, OpenAI, Google — jusqu'à ce qu'un réussisse
# (lib/ai/model.ts). Configurer plusieurs clés augmente la résilience : un
# fournisseur en panne (crédit épuisé, quota, limite de débit) est mis de
# côté automatiquement au profit du suivant.
NVIDIA_API_KEY="nvapi-xxxxx"
EDEN_AI_API_KEY="sk-eden-live-xxxxx"
MISTRAL_API_KEY="xxxxx"
ANTHROPIC_API_KEY="sk-ant-xxxxx"
OPENAI_API_KEY="sk-xxxxx"
GOOGLE_GENERATIVE_AI_API_KEY="AQ.xxxxx"
